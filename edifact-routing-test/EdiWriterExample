import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.io.OutputStream;
import java.nio.charset.Charset;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.logging.Level;
import java.util.logging.Logger;

import io.xlate.edi.schema.EDISchemaException;
import io.xlate.edi.stream.EDIOutputFactory;
import io.xlate.edi.stream.EDIStreamConstants;
import io.xlate.edi.stream.EDIStreamException;
import io.xlate.edi.stream.EDIStreamWriter;


class EdiGenerator {

	static {
    	Logger.getLogger("io.xlate.edi.internal.stream").setLevel(Level.SEVERE);
    }

    private final Character segmentDelimiter;
    private final Character elementDelimiter;
    private final Character componentDelimiter;
    private final Character releaseIndicator;
    private final boolean prettyPrint;
    private final Charset charset;

    private EdiGenerator(Builder builder) {
        this.segmentDelimiter = builder.segmentDelimiter;
        this.elementDelimiter = builder.elementDelimiter;
        this.componentDelimiter = builder.componentDelimiter;
        this.releaseIndicator = builder.releaseIndicator;
        this.prettyPrint = builder.prettyPrint;
        this.charset = builder.charset;
    }

    public static Builder builder() {
        return new Builder();
    }

    /**
     * 설정된 옵션을 바탕으로 StAEDI의 EDIOutputFactory를 생성합니다.
     * 구분자가 null인 경우 StAEDI 기본값(' + : ?)을 사용하며 UNA 헤더를 강제 출력 X
     */
    public EDIOutputFactory buildFactory() {
    	
        EDIOutputFactory factory = EDIOutputFactory.newFactory();

        if (segmentDelimiter != null) {
            factory.setProperty(EDIStreamConstants.Delimiters.SEGMENT, segmentDelimiter);
        }
        
        if (elementDelimiter != null) {
            factory.setProperty(EDIStreamConstants.Delimiters.DATA_ELEMENT, elementDelimiter);
        }
        
        if (componentDelimiter != null) {
            factory.setProperty(EDIStreamConstants.Delimiters.COMPONENT_ELEMENT, componentDelimiter);
        }
        
        if (releaseIndicator != null) {
            factory.setProperty(EDIStreamConstants.Delimiters.RELEASE, releaseIndicator);
        }

        factory.setProperty(EDIOutputFactory.PRETTY_PRINT, prettyPrint);
        return factory;
    }

    public byte[] toBytes(EdiWriteContext context) {
    	
        EDIOutputFactory factory = buildFactory();
        try (ByteArrayOutputStream baos = new ByteArrayOutputStream();
             EDIStreamWriter writer = factory.createEDIStreamWriter(baos, charset.name())) {

            writeEdiMessage(writer, context);
            writer.flush();
            return baos.toByteArray();

        }
        catch (EDISchemaException | EDIStreamException | IOException e) {
            throw new RuntimeException("EDIFACT 전문 바이트 생성 중 오류가 발생했습니다.", e);
        }
        
    }

    public String toString(EdiWriteContext context) {
        return new String(toBytes(context), charset);
    }

    public void writeTo(EdiWriteContext context, OutputStream outputStream) {
        EDIOutputFactory factory = buildFactory();
        try (EDIStreamWriter writer = factory.createEDIStreamWriter(outputStream, charset.name())) {
            writeEdiMessage(writer, context);
            writer.flush();
        } 
        catch (EDISchemaException | EDIStreamException e) {
            throw new RuntimeException("EDIFACT 스트림 출력 중 오류가 발생했습니다.", e);
        } 
    }

    public static final class Builder {
    	
        private Character segmentDelimiter = null;   // null이면 StAEDI 기본값(') 사용
        private Character elementDelimiter = null;   // null이면 StAEDI 기본값(+) 사용
        private Character componentDelimiter = null; // null이면 StAEDI 기본값(:) 사용
        private Character releaseIndicator = null;   // null이면 StAEDI 기본값(?) 사용
        private boolean prettyPrint = false;
        private Charset charset = StandardCharsets.UTF_8;

        private Builder() {}

        public Builder segmentDelimiter(char segmentDelimiter) {
            this.segmentDelimiter = segmentDelimiter;
            return this;
        }

        public Builder elementDelimiter(char elementDelimiter) {
            this.elementDelimiter = elementDelimiter;
            return this;
        }

        public Builder componentDelimiter(char componentDelimiter) {
            this.componentDelimiter = componentDelimiter;
            return this;
        }

        public Builder releaseIndicator(char releaseIndicator) {
            this.releaseIndicator = releaseIndicator;
            return this;
        }

        /**
         * 표준 EDIFACT 구분자 UNA 헤더(UNA:+.? ')가 출력
         */
        public Builder withUnaHeader() {
            this.segmentDelimiter = '\'';
            this.elementDelimiter = '+';
            this.componentDelimiter = ':';
            this.releaseIndicator = '?';
            return this;
        }

        public Builder prettyPrint(boolean prettyPrint) {
            this.prettyPrint = prettyPrint;
            return this;
        }

        public Builder charset(Charset charset) {
            if (charset != null) {
                this.charset = charset;
            }
            return this;
        }

        public Builder eucKr() {
            this.charset = Charset.forName("EUC-KR");
            return this;
        }

        public Builder utf8() {
            this.charset = StandardCharsets.UTF_8;
            return this;
        }

        public EdiGenerator build() {
            return new EdiGenerator(this);
        }
        
    }

    private void writeEdiMessage(EDIStreamWriter writer, EdiWriteContext context) throws EDIStreamException, EDISchemaException {
        writer.startInterchange();
        for (EdiSegment segment : context.getSegments()) {
            writeSegment(writer, segment);
        }
        writer.endInterchange();
    }

    private void writeSegment(EDIStreamWriter writer, EdiSegment segment) throws EDIStreamException {
    	
        writer.writeStartSegment(segment.getName());
        Map<Integer, EdiElement> elementMap = segment.getElementMap();
        if (elementMap.isEmpty()) {
            writer.writeEmptyElement();
        } else {
            int maxElements = elementMap.keySet().stream().max(Integer::compare).orElse(0);
            for (int i = 1; i <= maxElements; i++) {
                EdiElement element = elementMap.get(i);
                if (element == null) {
                    writer.writeStartElement();
                    writer.writeEmptyComponent();
                    writer.endElement();
                } else {
                    writeElement(writer, element);
                }
            }
        }
        writer.writeEndSegment();
        
    }

    private void writeElement(EDIStreamWriter writer, EdiElement element) throws EDIStreamException {
    	
        writer.writeStartElement();
        Map<Integer, EdiComponent> componentMap = element.getComponentMap();
        if (componentMap.isEmpty()) {
            writer.writeEmptyComponent();
        } else {
            int maxComponents = componentMap.keySet().stream().max(Integer::compare).orElse(0);
            for (int i = 1; i <= maxComponents; i++) {
                EdiComponent component = componentMap.get(i);
                if (component == null || component.getValue().isEmpty()) {
                    writer.writeEmptyComponent();
                } else {
                    writer.writeComponent(component.getValue());
                }
            }
        }
        writer.endElement();
        
    }
}



class EdiWriteContext {
    
    private final List<EdiSegment> segments = new ArrayList<>();

    private String currentInterchangeControlRef = "";
    private String currentMessageRef = "";
    private int currentMessageSegmentCount = 0;
    private int totalMessageCount = 0;
    private boolean isInsideMessage = false;

    public EdiWriteContext addSegment(EdiSegment segment) {
    	
        if (segment == null) {
            return this;
        }

        String segName = segment.getName();
        if ("UNB".equals(segName)) {
            this.currentInterchangeControlRef = segment.getFirstComponentValue(5);
            this.totalMessageCount = 0;
        } else if ("UNH".equals(segName)) {
            if (this.isInsideMessage) {
                throw new IllegalStateException("이전 메시지(UNH)가 닫히지 않았습니다. addUnt()를 먼저 호출하세요.");
            }
            this.isInsideMessage = true;
            this.currentMessageSegmentCount = 1; // UNH 자기 자신 포함
            this.currentMessageRef = segment.getFirstComponentValue(1);
        } else if (this.isInsideMessage && !"UNT".equals(segName)) {
            this.currentMessageSegmentCount++;
        }

        segments.add(segment);
        return this;
    }

    public EdiWriteContext addUnt() {
    	
        if (!this.isInsideMessage) {
            throw new IllegalStateException("UNH 세그먼트 없이 UNT를 추가할 수 없습니다.");
        }

        this.currentMessageSegmentCount++; // UNT 자기 자신 포함
        this.totalMessageCount++;          // 전체 메시지 건수 증가
        this.isInsideMessage = false;      // 메시지 블록 종료

        EdiSegment unt = new EdiSegment("UNT")
            .addElement(new EdiElement(1, String.valueOf(this.currentMessageSegmentCount)))
            .addElement(new EdiElement(2, this.currentMessageRef));

        segments.add(unt);
        return this;
    }

    /**
     * UNB에 대응하는 UNZ 세그먼트를 자동 계산하여 추가합니다.
     */
    public EdiWriteContext addUnz() {
    	
        if (this.isInsideMessage) {
            throw new IllegalStateException("닫히지 않은 메시지(UNH)가 있습니다. addUnt()를 먼저 호출하세요.");
        }
        if (this.currentInterchangeControlRef.isEmpty()) {
            throw new IllegalStateException("UNB 세그먼트가 없거나 제어번호(5번 엘리먼트)가 비어 있습니다.");
        }

        EdiSegment unz = new EdiSegment("UNZ")
            .addElement(new EdiElement(1, String.valueOf(this.totalMessageCount)))
            .addElement(new EdiElement(2, this.currentInterchangeControlRef));

        segments.add(unz);
        return this;
        
    }

    public List<EdiSegment> getSegments() {
        return segments;
    }
    
}


class EdiSegment {
	
    private final String name;
    private final Map<Integer, EdiElement> elementMap = new LinkedHashMap<>();

    public EdiSegment(String name) {
        this.name = name;
    }

    public String getName() {
        return name;
    }

    public Map<Integer, EdiElement> getElementMap() {
        return elementMap;
    }

    public EdiSegment addElement(EdiElement element) {
        if (element != null) {
            elementMap.put(element.getPriority(), element);
        }
        return this;
    }

    public String getFirstComponentValue(int elementPriority) {
        EdiElement element = elementMap.get(elementPriority);
        if (element == null) {
            return "";
        }
        EdiComponent component = element.getComponentMap().get(1);
        return (component == null) ? "" : component.getValue();
    }
}

