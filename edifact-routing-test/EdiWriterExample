// 5. EdiComponent.java
// =========================================================
class EdiComponent {
    private final int priority;
    private final String value;

    public EdiComponent(int priority, String value) {
        this.priority = priority;
        this.value = (value == null) ? "" : value;
    }

    public EdiComponent(int priority, String value, int maxEucKrBytes) {
        this.priority = priority;
        this.value = EdiStringUtils.truncateEucKr(value, maxEucKrBytes);
    }

    public EdiComponent(int priority, String value, int maxBytes, Charset charset) {
        this.priority = priority;
        this.value = EdiStringUtils.truncateByByte(value, maxBytes, charset);
    }

    public int getPriority() {
        return priority;
    }

    public String getValue() {
        return value;
    }
}

class EdiStringUtils {

    public static final Charset CHARSET_EUC_KR = Charset.forName("EUC-KR");

    private EdiStringUtils() {}

    public static String truncateByByte(String str, int maxBytes, Charset charset) {
        if (str == null || str.isEmpty() || maxBytes <= 0) {
            return "";
        }
        if (str.getBytes(charset).length <= maxBytes) {
            return str;
        }

        StringBuilder sb = new StringBuilder();
        int currentBytes = 0;
        int offset = 0;

        while (offset < str.length()) {
            int codePoint = str.codePointAt(offset);
            int charCount = Character.charCount(codePoint);
            String singleChar = str.substring(offset, offset + charCount);

            int charByteLength = singleChar.getBytes(charset).length;
            if (currentBytes + charByteLength > maxBytes) {
                break;
            }

            sb.append(singleChar);
            currentBytes += charByteLength;
            offset += charCount;
        }

        return sb.toString();
    }

    public static String truncateEucKr(String str, int maxBytes) {
        return truncateByByte(str, maxBytes, CHARSET_EUC_KR);
    }
}


public class EdiWriterExample {

	public static void main(String[] args) {
		
		EdiWriteContext ctx = new EdiWriteContext();
		
		// 1. UNB (인터체인지 시작 - 제어번호: 90000000002803)
		ctx.addSegment(new EdiSegment("UNB").addElement(new EdiElement(1, "KECA", "4"))
				.addElement(new EdiElement(2, "BWH04077153", "57")).addElement(new EdiElement(3, "KCS4G002", "57"))
				.addElement(new EdiElement(4, "20260921", "1115")).addElement(new EdiElement(5, "90000000002803"))
				.addElement(new EdiElement(7, "CUSCAR")).addElement(new EdiElement(9, "0")));

		// 2. 첫 번째 메시지 블록 (UNH ~ UNT) -> 총 4개 세그먼트 예상
		ctx.addSegment(new EdiSegment("UNH")
				.addElement(new EdiElement(1, "MSG0001").addComponent(new EdiComponent(2,"bbo")))
				.addElement(new EdiElement(2, "CUSCAR", "D", "96A", "UN")));
		ctx.addSegment(new EdiSegment("BGM")
				.addElement(new EdiElement(1, "85"))
				.addElement(new EdiElement(2, "DOC12345")));
		ctx.addSegment(new EdiSegment("DTM")
				.addElement(new EdiElement(1, "137", "20260921", "102")));
		ctx.addUnt(); // 자동으로 UNT+4+MSG0001' 생성!

		// 4. 인터체인지 종료 -> 총 2건의 메시지, 제어번호 90000000002803 자동 반영
		ctx.addUnz(); // 자동으로 UNZ+2+90000000002803' 생성!
		
		
		EdiGenerator kcsGenerator = EdiGenerator.builder().eucKr().build();

		byte[] payload = kcsGenerator.toBytes(ctx);
		System.out.println(new String(payload,Charset.forName("euc-kr")));
		// 2. 개발자 디버깅용 (UTF-8, 세그먼트별 줄바꿈 적용)
		EdiGenerator debugGenerator = EdiGenerator.builder()
		    .utf8()
		    .prettyPrint(true)
		    .build();

		System.out.println(debugGenerator.toString(ctx));

		// 3. 특수한 커스텀 구분자가 필요한 수신처 대응
		EdiGenerator customGenerator = EdiGenerator.builder()
		    .utf8()
		    .build();

		String customEdi = customGenerator.toString(ctx);
		System.out.println(customEdi);
	}

	
	
}
