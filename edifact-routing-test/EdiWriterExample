// 4. EdiElement.java
// =========================================================
class EdiElement {
	
    private final int priority;
    private final Map<Integer, EdiComponent> componentMap = new LinkedHashMap<>();

    public EdiElement(int priority) {
        this.priority = priority;
    }

    public EdiElement(int priority, String... values) {
        this.priority = priority;
        if (values != null) {
            for (int i = 0; i < values.length; i++) {
                addComponent(new EdiComponent(i + 1, values[i]));
            }
        }
    }

    public EdiElement(int priority, List<String> valueList) {
        this.priority = priority;
        if (valueList != null) {
            for (int i = 0; i < valueList.size(); i++) {
                addComponent(new EdiComponent(i + 1, valueList.get(i)));
            }
        }
    }

    public int getPriority() {
        return priority;
    }

    public Map<Integer, EdiComponent> getComponentMap() {
        return componentMap;
    }

    public EdiElement addComponent(EdiComponent component) {
        if (component != null) {
            componentMap.put(component.getPriority(), component);
        }
        return this;
    }
}

